}

<div class="auth-shell auth-shell-single">
    <section class="auth-panel text-center">
        <div class="auth-icon mx-auto mb-4">
            <i class="bi bi-shield-exclamation"></i>
        </div>
        <p class="eyebrow">403</p>
        <h1>Недостатньо прав</h1>
        <p class="text-muted">Ця дія доступна лише користувачам з відповідною роллю.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
            <i class="bi bi-house-door me-2"></i>На панель
        </a>
    </section>
</div>
