@page
@model DabaTaseApp.Areas.Identity.Pages.Account.LoginModel

@{
    ViewData["Title"] = "Вхід";
}

<div class="auth-shell">
    <section class="auth-panel auth-copy">
        <div class="auth-brand-icon">
            <i class="bi bi-mortarboard"></i>
        </div>
        <h1>Портал автошколи</h1>
        <p>Платформа для адміністраторів, інструкторів та учнів автошколи.</p>
        <ul class="auth-feature-list">
            <li><i class="bi bi-calendar-check me-2"></i>Розклад теорії та практики</li>
            <li><i class="bi bi-people me-2"></i>Навчальні групи та учні</li>
            <li><i class="bi bi-person-badge me-2"></i>Особистий профіль та баланс</li>
        </ul>
    </section>

    <section class="auth-panel">
        <form method="post" class="auth-form">
            <h2 class="mb-1">Вхід до порталу автошколи</h2>
            <p class="text-muted mb-4">Увійдіть, щоб переглянути розклад занять, навчальні групи та особисті дані.</p>
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="text-danger validation-summary mb-3"></div>

            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label">Email</label>
                <input asp-for="Input.Email" class="form-control form-control-lg" autocomplete="username" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label">Пароль</label>
                <input asp-for="Input.Password" class="form-control form-control-lg" autocomplete="current-password" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="form-check mb-4">
                <input asp-for="Input.RememberMe" class="form-check-input" />
                <label asp-for="Input.RememberMe" class="form-check-label">Запам'ятати мене</label>
            </div>

            <button type="submit" class="btn btn-primary btn-lg w-100">
                <i class="bi bi-box-arrow-in-right me-2"></i>Увійти
            </button>

            <div class="auth-switch">
                Немає акаунта? Зверніться до адміністратора автошколи.
            </div>
        </form>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
