@page
@model DabaTaseApp.Areas.Identity.Pages.Account.RegisterModel

@{
    ViewData["Title"] = "Реєстрація";
}

<div class="auth-shell">
    <section class="auth-panel auth-copy">
        <p class="eyebrow">Student Access</p>
        <h1>Створіть учнівський кабінет</h1>
        <p>Після реєстрації акаунт автоматично отримує роль учня і прив'язується до персональної картки.</p>
        <div class="auth-metrics">
            <span><strong>1</strong> профіль</span>
            <span><strong>0</strong> зайвих прав</span>
            <span><strong>auto</strong> роль</span>
        </div>
    </section>

    <section class="auth-panel">
        <form method="post" class="auth-form">
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="text-danger validation-summary"></div>

            <div class="mb-3">
                <label asp-for="Input.FullName" class="form-label"></label>
                <input asp-for="Input.FullName" class="form-control form-control-lg" autocomplete="name" />
                <span asp-validation-for="Input.FullName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.TargetCategory" class="form-label"></label>
                <select asp-for="Input.TargetCategory" asp-items="Model.CategoryOptions" class="form-select form-select-lg"></select>
                <span asp-validation-for="Input.TargetCategory" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label">Email</label>
                <input asp-for="Input.Email" class="form-control form-control-lg" autocomplete="username" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label">Пароль</label>
                <input asp-for="Input.Password" class="form-control form-control-lg" autocomplete="new-password" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                <input asp-for="Input.ConfirmPassword" class="form-control form-control-lg" autocomplete="new-password" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-lg w-100">
                <i class="bi bi-person-plus me-2"></i>Створити доступ
            </button>

            <div class="auth-switch">
                Вже маєте акаунт?
                <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Увійти</a>
            </div>
        </form>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
