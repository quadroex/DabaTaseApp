@page
@model DabaTaseApp.Areas.Identity.Pages.Account.RegisterModel

@{
    ViewData["Title"] = "Реєстрація недоступна";
}

<div class="auth-shell">
    <section class="auth-panel auth-copy">
        <p class="eyebrow">DriveForce</p>
        <h1>Реєстрація недоступна</h1>
        <p>Зверніться до адміністратора, щоб отримати акаунт і прив'язати його до картки учня або інструктора.</p>
    </section>

    <section class="auth-panel">
        <div class="auth-form">
            <div class="alert alert-warning mb-4">
                Реєстрація недоступна. Зверніться до адміністратора.
            </div>
            <a class="btn btn-primary btn-lg w-100" asp-page="./Login">
                <i class="bi bi-box-arrow-in-right me-2"></i>Увійти
            </a>
        </div>
    </section>
</div>
