@model DabaTaseApp.Models.Category

@{
    ViewData["Title"] = "Видалити категорію";
}

<div class="surface-toolbar">
    <div>
        <p class="eyebrow mb-2">Категорії</p>
        <h1 class="mb-0 text-danger">Підтвердження видалення</h1>
    </div>
</div>

<div class="card-custom">
    <p class="text-danger mb-3">Ви впевнені, що хочете видалити цю категорію?</p>
    <dl class="row mb-4">
        <dt class="col-sm-3 text-muted">Назва</dt>
        <dd class="col-sm-9"><span class="badge bg-primary fs-6 px-3 py-2 rounded-pill">@Model.Name</span></dd>

        <dt class="col-sm-3 text-muted">Опис</dt>
        <dd class="col-sm-9 text-muted">@Model.Description</dd>
    </dl>

    <div class="d-flex gap-2">
        <form asp-action="Delete" method="post" class="d-inline">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash3 me-2"></i>Видалити
            </button>
        </form>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>Назад
        </a>
    </div>
</div>
