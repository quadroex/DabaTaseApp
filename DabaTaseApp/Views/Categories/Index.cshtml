@model IEnumerable<DabaTaseApp.Models.Category>
@{
    ViewData["Title"] = "Категорії";
}

<div class="surface-toolbar mb-4">
    <div>
        <p class="eyebrow mb-2">Довідник</p>
        <h1 class="mb-0">Категорії</h1>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-primary shadow-sm"><i class="bi bi-plus-lg me-2"></i>Додати</a>
        <a asp-action="Export" class="btn btn-success shadow-sm"><i class="bi bi-file-earmark-excel me-2"></i>Експорт</a>
    </div>
</div>

<div class="card-custom mb-4 py-3 bg-light border-0">
    <form asp-action="Import" enctype="multipart/form-data" method="post" class="d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-3">
            <i class="bi bi-cloud-arrow-up fs-3 text-muted"></i>
            <div>
                <strong class="d-block">Імпорт категорій</strong>
                <small class="text-muted">Оберіть файл .xlsx для імпорту</small>
            </div>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <input type="file" name="fileExcel" class="form-control" accept=".xlsx" required style="max-width: 300px;" />
            <button type="submit" class="btn btn-warning shadow-sm"><i class="bi bi-upload me-2"></i>Імпортувати</button>
        </div>
    </form>
</div>

<div class="card-custom">
    <table class="table">
        <thead>
            <tr>
                <th style="width: 20%;">Назва</th>
                <th>Опис</th>
                <th class="text-end">Дії</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><span class="badge bg-primary fs-6 px-3 py-2 rounded-pill shadow-sm">@item.Name</span></td>
                    <td class="text-muted">@item.Description</td>
                    <td class="text-end">
                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn-action" aria-label="Деталі"><i class="bi bi-info-circle"></i></a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action text-primary" aria-label="Редагувати"><i class="bi bi-pencil-square"></i></a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn-action text-danger" aria-label="Видалити"><i class="bi bi-trash3"></i></a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>