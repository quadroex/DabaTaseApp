@model DabaTaseApp.Models.Group

@{
    ViewData["Title"] = "Створити групу";
}

<div class="surface-toolbar">
    <div>
        <p class="eyebrow mb-2">Групи</p>
        <h1 class="mb-0">Нова група</h1>
    </div>
</div>

<div class="card-custom">
    <form asp-action="Create" class="row g-3">
        <div asp-validation-summary="ModelOnly" class="col-12 text-danger"></div>

        <div class="col-12 col-lg-4">
            <label asp-for="GroupName" class="form-label">Назва групи</label>
            <input asp-for="GroupName" class="form-control" placeholder="Наприклад: Група-2026-А" />
            <span asp-validation-for="GroupName" class="text-danger"></span>
        </div>

        <div class="col-12 col-lg-4">
            <label asp-for="TheoryInstructorId" class="form-label">Інструктор теорії</label>
            <select asp-for="TheoryInstructorId" class="form-select" asp-items="ViewBag.TheoryInstructorId"></select>
        </div>

        <div class="col-12 col-lg-4">
        </div>

        <div class="col-12 col-lg-4">
            <label asp-for="StartDate" class="form-label">Дата початку</label>
            <input asp-for="StartDate" class="form-control" type="date" />
            <span asp-validation-for="StartDate" class="text-danger"></span>
        </div>

        <div class="col-12 col-lg-4">
            <label asp-for="EndDate" class="form-label">Дата закінчення</label>
            <input asp-for="EndDate" class="form-control" type="date" />
            <span asp-validation-for="EndDate" class="text-danger"></span>
        </div>

        <div class="col-12 d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check2 me-2"></i>Створити
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">Назад</a>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
