@model DabaTaseApp.Models.Group

@{
    ViewData["Title"] = "Видалити групу";
}

<div class="surface-toolbar">
    <div>
        <p class="eyebrow mb-2">Групи</p>
        <h1 class="mb-0 text-danger">Підтвердження видалення</h1>
    </div>
</div>

<div class="card-custom">
    <p class="text-danger mb-3">Ви впевнені, що хочете видалити цю групу?</p>
    <dl class="row mb-4">
        <dt class="col-sm-3 text-muted">Назва групи</dt>
        <dd class="col-sm-9 fw-bold text-primary">@Model.GroupName</dd>

        <dt class="col-sm-3 text-muted">Початок навчання</dt>
        <dd class="col-sm-9">@Model.StartDate.ToShortDateString()</dd>

        <dt class="col-sm-3 text-muted">Кінець навчання</dt>
        <dd class="col-sm-9">@Model.EndDate.ToShortDateString()</dd>

        <dt class="col-sm-3 text-muted">Інструктор теорії</dt>
        <dd class="col-sm-9">@(Model.TheoryInstructor?.FullName ?? "Не призначено")</dd>
    </dl>

    <div class="d-flex gap-2">
        <form asp-action="Delete" method="post" class="d-inline">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash3 me-2"></i>Видалити
            </button>
        </form>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>Назад
        </a>
    </div>
</div>
