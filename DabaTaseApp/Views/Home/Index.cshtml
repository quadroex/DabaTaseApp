@{
    var isSignedIn = User.Identity?.IsAuthenticated ?? false;
    var isAdmin = User.IsInRole(AppRoles.Admin);
    var isInstructor = User.IsInRole(AppRoles.Instructor);
    var isStudent = User.IsInRole(AppRoles.Student);
    var student = ViewBag.Student as Student;
    var nextPractice = ViewBag.NextPracticeSession as PracticeSession;
    var nextTheory = ViewBag.NextTheorySession as TheorySession;

    if (isSignedIn)
    {
        ViewData["Title"] = "Панель керування";
    }
    else
    {
        ViewData["Title"] = "DriveForce";
        ViewData["HidePageHeader"] = true;
    }
}

@if (!isSignedIn)
{
    <div class="anonymous-home">
        <div class="card-custom anonymous-card text-center">
            <div class="anonymous-icon mb-3">
                <i class="bi bi-mortarboard"></i>
            </div>
            <h1 class="mb-2">Портал автошколи DriveForce</h1>
            <p class="text-muted mb-4">Увійдіть, щоб переглянути розклад занять, навчальні групи, практику та особисті дані.</p>
            <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary btn-lg px-5 mb-3">
                <i class="bi bi-box-arrow-in-right me-2"></i>Увійти
            </a>
            <p class="text-muted small mb-4">Акаунти створює адміністратор автошколи.</p>
            <div class="anonymous-features">
                <div class="anonymous-feature">
                    <i class="bi bi-calendar-check"></i>
                    <span>Розклад занять</span>
                </div>
                <div class="anonymous-feature">
                    <i class="bi bi-people"></i>
                    <span>Навчальні групи</span>
                </div>
                <div class="anonymous-feature">
                    <i class="bi bi-wallet2"></i>
                    <span>Оплати та доступи</span>
                </div>
            </div>
        </div>
    </div>
}
else if (isAdmin)
{
    <div class="surface-toolbar">
        <div>
            <p class="eyebrow mb-2">Статистика</p>
            <h1 class="mb-0">Вітаємо, @User.Identity?.Name</h1>
        </div>
        <div>
            <div class="dashboard-filter">
                <input type="date" id="startDate" class="form-control form-control-sm" />
                <input type="date" id="endDate" class="form-control form-control-sm" />
                <button id="filterBtn" class="btn btn-primary btn-sm">
                    <i class="bi bi-funnel me-1"></i>Застосувати
                </button>
                <button id="resetBtn" class="btn btn-outline-secondary btn-sm d-none" type="button">
                    <i class="bi bi-x-circle me-1"></i>Скинути
                </button>
            </div>
            <div id="dateRangeError" class="text-danger small mt-2 d-none"></div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-12 col-md-6 col-xl-3">
            <div class="stat-card">
                <div class="d-flex justify-content-between align-items-center gap-3">
                    <div>
                        <div class="text-muted small fw-bold text-uppercase mb-1">Дохід</div>
                        <div class="fs-3 fw-bold">@ViewBag.TotalRevenue.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) ₴</div>
                    </div>
                    <div class="stat-icon"><i class="bi bi-wallet2 fs-4"></i></div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <div class="stat-card" style="border-left-color: #15803d;">
                <div class="d-flex justify-content-between align-items-center gap-3">
                    <div>
                        <div class="text-muted small fw-bold text-uppercase mb-1">Учні</div>
                        <div class="fs-3 fw-bold">@ViewBag.TotalStudents</div>
                    </div>
                    <div class="stat-icon"><i class="bi bi-people fs-4"></i></div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <div class="stat-card" style="border-left-color: #f59e0b;">
                <div class="d-flex justify-content-between align-items-center gap-3">
                    <div>
                        <div class="text-muted small fw-bold text-uppercase mb-1">Авто активні</div>
                        <div class="fs-3 fw-bold">@ViewBag.ActiveVehicles</div>
                    </div>
                    <div class="stat-icon"><i class="bi bi-car-front fs-4"></i></div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <div class="stat-card" style="border-left-color: #dc2626;">
                <div class="d-flex justify-content-between align-items-center gap-3">
                    <div>
                        <div class="text-muted small fw-bold text-uppercase mb-1">Заняття</div>
                        <div class="fs-3 fw-bold">@ViewBag.ActiveSessions</div>
                    </div>
                    <div class="stat-icon"><i class="bi bi-calendar2-check fs-4"></i></div>
                </div>
            </div>
        </div>
    </div>

    <div class="quick-grid mb-4">
        <a class="quick-link" asp-controller="Students" asp-action="Index">
            <i class="bi bi-mortarboard"></i>
            <span><strong>Учні</strong><br /><small class="text-muted">Картки та групи</small></span>
        </a>
        <a class="quick-link" asp-controller="Users" asp-action="Index">
            <i class="bi bi-shield-lock"></i>
            <span><strong>Доступи</strong><br /><small class="text-muted">Користувачі та ролі</small></span>
        </a>
        <a class="quick-link" asp-controller="Payments" asp-action="Index">
            <i class="bi bi-wallet2"></i>
            <span><strong>Фінанси</strong><br /><small class="text-muted">Оплати та баланс</small></span>
        </a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-12 col-xl-8">
            <div class="card-custom h-100">
                <h5 class="mb-3">Динаміка прибутку</h5>
                <div id="revenueChart" style="width: 100%; height: 350px;"></div>
            </div>
        </div>
        <div class="col-12 col-xl-4">
            <div class="card-custom h-100">
                <h5 class="mb-3">Категорії учнів</h5>
                <div id="categoryChart" style="width: 100%; height: 350px;"></div>
            </div>
        </div>
    </div>

    <div class="card-custom">
        <h5 class="mb-3">Навантаження інструкторів</h5>
        <div id="instructorChart" style="width: 100%; height: 350px;"></div>
    </div>

    @section Scripts {
        <script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>
        <script type="text/javascript">
            google.charts.load('current', { packages: ['corechart'] });
            google.charts.setOnLoadCallback(refreshDashboard);

            const startInput = document.getElementById('startDate');
            const endInput = document.getElementById('endDate');
            const errorNode = document.getElementById('dateRangeError');

            function validateDateRange() {
                const start = startInput.value;
                const end = endInput.value;
                const invalid = start && end && start > end;

                errorNode.classList.toggle('d-none', !invalid);
                errorNode.textContent = invalid ? 'Дата початку не може бути пізніше дати закінчення.' : '';
                return !invalid;
            }

            function refreshDashboard() {
                if (!validateDateRange()) {
                    return;
                }

                const start = startInput.value;
                const end = endInput.value;
                drawCategory();
                drawRevenue(start, end);
                drawInstructors(start, end);
            }

            async function loadJson(url) {
                const response = await fetch(url);
                if (!response.ok) {
                    const payload = await response.json().catch(() => ({}));
                    throw new Error(payload.message || 'Не вдалося завантажити статистику.');
                }

                return response.json();
            }

            function drawCategory() {
                loadJson('/api/charts/studentsByCategory')
                    .then(data => {
                        const container = document.getElementById('categoryChart');
                        if (!data || data.length === 0) {
                            container.innerHTML = '<div class="empty-state">Даних поки немає</div>';
                            return;
                        }

                        const dt = new google.visualization.DataTable();
                        dt.addColumn('string', 'Категорія');
                        dt.addColumn('number', 'Учні');
                        data.forEach(i => dt.addRow([i.label, i.value]));
                        new google.visualization.PieChart(container).draw(dt, {
                            pieHole: 0.45,
                            colors: ['#0f766e', '#f59e0b', '#2563eb', '#dc2626', '#7c3aed', '#0891b2'],
                            chartArea: { width: '90%', height: '80%' },
                            legend: { position: 'bottom' }
                        });
                    })
                    .catch(showChartError);
            }

            function drawRevenue(start, end) {
                loadJson(`/api/charts/revenueByDate?startDate=${start}&endDate=${end}`)
                    .then(data => {
                        const container = document.getElementById('revenueChart');
                        if (!data || data.length === 0) {
                            container.innerHTML = '<div class="empty-state">Транзакції за обраний період відсутні</div>';
                            return;
                        }

                        const dt = new google.visualization.DataTable();
                        dt.addColumn('string', 'Дата');
                        dt.addColumn('number', 'Сума');
                        data.forEach(i => dt.addRow([i.label, i.value]));

                        const chart = data.length === 1
                            ? new google.visualization.ColumnChart(container)
                            : new google.visualization.AreaChart(container);

                        chart.draw(dt, {
                            colors: ['#0f766e'],
                            areaOpacity: 0.14,
                            chartArea: { width: '85%', height: '70%' },
                            legend: { position: 'none' },
                            vAxis: { minValue: 0 },
                            animation: { startup: true, duration: 700, easing: 'out' }
                        });
                    })
                    .catch(showChartError);
            }

            function drawInstructors(start, end) {
                loadJson(`/api/charts/sessionsByInstructor?startDate=${start}&endDate=${end}`)
                    .then(data => {
                        const container = document.getElementById('instructorChart');
                        if (!data || data.length === 0) {
                            container.innerHTML = '<div class="empty-state">Заняття не знайдено</div>';
                            return;
                        }

                        const dt = new google.visualization.DataTable();
                        dt.addColumn('string', 'Інструктор');
                        dt.addColumn('number', 'Заняття');
                        data.forEach(i => dt.addRow([i.label, i.value]));
                        new google.visualization.ColumnChart(container).draw(dt, {
                            colors: ['#f59e0b'],
                            chartArea: { width: '90%', height: '75%' },
                            legend: { position: 'none' }
                        });
                    })
                    .catch(showChartError);
            }

            function showChartError(error) {
                errorNode.classList.remove('d-none');
                errorNode.textContent = error.message;
            }

            const resetBtn = document.getElementById('resetBtn');

            function updateResetBtn() {
                resetBtn.classList.toggle('d-none', !startInput.value && !endInput.value);
            }

            startInput.addEventListener('change', function () { validateDateRange(); updateResetBtn(); });
            endInput.addEventListener('change', function () { validateDateRange(); updateResetBtn(); });
            document.getElementById('filterBtn').addEventListener('click', refreshDashboard);
            resetBtn.addEventListener('click', function () {
                startInput.value = '';
                endInput.value = '';
                errorNode.classList.add('d-none');
                errorNode.textContent = '';
                updateResetBtn();
                refreshDashboard();
            });
        </script>
    }
}
else if (isInstructor)
{
    <div class="surface-toolbar">
        <div>
            <p class="eyebrow mb-2">Робоча панель</p>
            <h1 class="mb-0">Вітаємо, @User.Identity?.Name</h1>
            <p class="text-muted mb-0">Статистика та фінансові діаграми доступні тільки адміністратору.</p>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-12 col-md-6 col-xl-3">
            <div class="stat-card">
                <div class="text-muted small fw-bold text-uppercase mb-1">Учні</div>
                <div class="fs-3 fw-bold">@ViewBag.TotalStudents</div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <div class="stat-card" style="border-left-color: #f59e0b;">
                <div class="text-muted small fw-bold text-uppercase mb-1">Авто активні</div>
                <div class="fs-3 fw-bold">@ViewBag.ActiveVehicles</div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <div class="stat-card" style="border-left-color: #2563eb;">
                <div class="text-muted small fw-bold text-uppercase mb-1">Майбутня теорія</div>
                <div class="fs-3 fw-bold">@ViewBag.UpcomingTheorySessions</div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <div class="stat-card" style="border-left-color: #15803d;">
                <div class="text-muted small fw-bold text-uppercase mb-1">Майбутня практика</div>
                <div class="fs-3 fw-bold">@ViewBag.UpcomingPracticeSessions</div>
            </div>
        </div>
    </div>

    <div class="quick-grid">
        <a class="quick-link" asp-controller="TheorySessions" asp-action="Index">
            <i class="bi bi-journal-text"></i>
            <span><strong>Теорія</strong><br /><small class="text-muted">Розклад лекцій</small></span>
        </a>
        <a class="quick-link" asp-controller="PracticeSessions" asp-action="Index">
            <i class="bi bi-cone-striped"></i>
            <span><strong>Практика</strong><br /><small class="text-muted">Заняття та авто</small></span>
        </a>
        <a class="quick-link" asp-controller="Students" asp-action="Index">
            <i class="bi bi-mortarboard"></i>
            <span><strong>Учні</strong><br /><small class="text-muted">Картки та групи</small></span>
        </a>
    </div>
}
else if (isStudent)
{
    <div class="surface-toolbar">
        <div>
            <p class="eyebrow mb-2">Учнівський кабінет</p>
            <h1 class="mb-0">Вітаємо, @(student?.FullName ?? User.Identity?.Name)</h1>
        </div>
        <a asp-controller="Payments" asp-action="TopUp" class="btn btn-primary">
            <i class="bi bi-plus-lg me-2"></i>Поповнити
        </a>
    </div>

    @if (student == null)
    {
        <div class="card-custom empty-state">
            <i class="bi bi-person-vcard"></i>
            <h5>Картку учня ще не прив'язано</h5>
            <p>Зверніться до адміністратора, щоб під'єднати акаунт до навчальної картки.</p>
        </div>
    }
    else
    {
        <div class="row g-3">
            <div class="col-12 col-lg-4">
                <div class="stat-card">
                    <div class="text-muted small fw-bold text-uppercase mb-1">Баланс</div>
                    <div class="display-6 fw-bold">@ViewBag.StudentBalance.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) ₴</div>
                    <div class="text-muted">Категорія @student.TargetCategory</div>
                </div>
            </div>
            <div class="col-12 col-lg-4">
                <div class="card-custom h-100">
                    <h5>Найближча практика</h5>
                    @if (nextPractice == null)
                    {
                        <p class="text-muted mb-0">Практичних занять не заплановано.</p>
                    }
                    else
                    {
                        <div class="fw-bold">@nextPractice.StartTime.ToString("dd.MM.yyyy HH:mm")</div>
                        <div class="text-muted">@nextPractice.Instructor?.FullName</div>
                        <span class="status-badge status-planned mt-2">@nextPractice.VehiclePlate</span>
                    }
                </div>
            </div>
            <div class="col-12 col-lg-4">
                <div class="card-custom h-100">
                    <h5>Найближча теорія</h5>
                    @if (nextTheory == null)
                    {
                        <p class="text-muted mb-0">Теоретичних занять не заплановано.</p>
                    }
                    else
                    {
                        <div class="fw-bold">@nextTheory.StartTime.ToString("dd.MM.yyyy HH:mm")</div>
                        <div class="text-muted">@nextTheory.Instructor?.FullName</div>
                        <span class="status-badge status-ongoing mt-2">@nextTheory.Location</span>
                    }
                </div>
            </div>
        </div>

        <div class="quick-grid mt-4">
            <a class="quick-link" asp-controller="Students" asp-action="Details" asp-route-id="@student.Id">
                <i class="bi bi-person-vcard"></i>
                <span><strong>Моя картка</strong><br /><small class="text-muted">@student.Group?.GroupName</small></span>
            </a>
            <a class="quick-link" asp-controller="TheorySessions" asp-action="Index">
                <i class="bi bi-journal-text"></i>
                <span><strong>Теорія</strong><br /><small class="text-muted">Розклад групи</small></span>
            </a>
            <a class="quick-link" asp-controller="PracticeSessions" asp-action="Index">
                <i class="bi bi-cone-striped"></i>
                <span><strong>Практика</strong><br /><small class="text-muted">Персональні заняття</small></span>
            </a>
        </div>
    }
}
