@model DabaTaseApp.Models.Instructor

@{
    ViewData["Title"] = "Деталі інструктора";
    var isAdmin = User.IsInRole(AppRoles.Admin);
}

<div class="surface-toolbar">
    <div>
        <p class="eyebrow mb-2">Інструктори</p>
        <h1 class="mb-0">@Model.FullName</h1>
    </div>
    <div class="d-flex gap-2">
        @if (isAdmin)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">
                <i class="bi bi-pencil me-2"></i>Редагувати
            </a>
        }
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>Назад
        </a>
    </div>
</div>

<div class="card-custom">
    <dl class="row mb-0">
        <dt class="col-sm-3 text-muted">ПІБ</dt>
        <dd class="col-sm-9 fw-bold">@Model.FullName</dd>

        <dt class="col-sm-3 text-muted">Телефон</dt>
        <dd class="col-sm-9">@Model.PhoneNumber</dd>

        <dt class="col-sm-3 text-muted">Серія посвідчення</dt>
        <dd class="col-sm-9">@Model.LicenseSerial</dd>

        <dt class="col-sm-3 text-muted">Акаунт</dt>
        <dd class="col-sm-9">@(Model.ApplicationUser?.Email ?? "Не прив'язано")</dd>
    </dl>
</div>
