@model DabaTaseApp.Models.Payment

@{
    ViewData["Title"] = "Новий платіж";
}

<div class="surface-toolbar">
    <div>
        <p class="eyebrow mb-2">Фінанси</p>
        <h1 class="mb-0">Додати платіж</h1>
    </div>
</div>

<div class="card-custom">
    <form asp-action="Create" class="row g-3">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="col-12 col-lg-4">
            <label asp-for="StudentId" class="form-label"></label>
            <select asp-for="StudentId" class="form-select" asp-items="ViewBag.StudentId"></select>
            <span asp-validation-for="StudentId" class="text-danger"></span>
        </div>

        <div class="col-12 col-lg-4">
            <label asp-for="Amount" class="form-label"></label>
            <input asp-for="Amount" class="form-control" />
            <span asp-validation-for="Amount" class="text-danger"></span>
        </div>

        <div class="col-12 col-lg-4">
            <label asp-for="PaymentDate" class="form-label"></label>
            <input asp-for="PaymentDate" class="form-control" type="datetime-local" />
            <span asp-validation-for="PaymentDate" class="text-danger"></span>
        </div>

        <div class="col-12 d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check2 me-2"></i>Зберегти
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">Назад</a>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
