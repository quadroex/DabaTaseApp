@model DabaTaseApp.Models.Payment

@{
    ViewData["Title"] = "Видалити платіж";
}

<div class="surface-toolbar">
    <div>
        <p class="eyebrow mb-2">Платежі</p>
        <h1 class="mb-0 text-danger">Підтвердження видалення</h1>
    </div>
</div>

<div class="card-custom">
    <p class="text-danger mb-3">Ви впевнені, що хочете видалити цей платіж?</p>
    <dl class="row mb-4">
        <dt class="col-sm-3 text-muted">Учень</dt>
        <dd class="col-sm-9 fw-bold">@(Model.Student?.FullName ?? "—")</dd>

        <dt class="col-sm-3 text-muted">Сума</dt>
        <dd class="col-sm-9 fw-bold text-success">@Model.Amount.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) ₴</dd>

        <dt class="col-sm-3 text-muted">Дата</dt>
        <dd class="col-sm-9">@Model.PaymentDate.ToString("dd.MM.yyyy HH:mm")</dd>
    </dl>

    <div class="d-flex gap-2">
        <form asp-action="Delete" method="post" class="d-inline">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash3 me-2"></i>Видалити
            </button>
        </form>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>Назад
        </a>
    </div>
</div>
