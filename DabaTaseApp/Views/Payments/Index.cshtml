@model IEnumerable<DabaTaseApp.Models.Payment>

@{
    ViewData["Title"] = "Фінанси";
    var isAdmin = User.IsInRole(AppRoles.Admin);
}

<div class="surface-toolbar">
    <div>
        <p class="eyebrow mb-2">Платежі</p>
        <h1 class="mb-0">Фінанси</h1>
        <p class="text-muted mb-0">Історія поповнень і коригувань балансу.</p>
    </div>
    @if (isAdmin)
    {
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-2"></i>Додати платіж</a>
    }
    else
    {
        <a asp-action="TopUp" class="btn btn-primary"><i class="bi bi-plus-lg me-2"></i>Поповнити баланс</a>
    }
</div>

<div class="card-custom">
    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-wallet2"></i>
            <h5>Платежів поки немає</h5>
            <p>Після поповнення або ручного платежу історія з'явиться тут.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Дата</th>
                        <th>Учень</th>
                        <th>Сума</th>
                        <th class="text-end">Дії</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-muted">@item.PaymentDate.ToString("dd.MM.yyyy HH:mm")</td>
                            <td class="fw-bold">@item.Student?.FullName</td>
                            <td><span class="status-badge status-done">+ @item.Amount.ToString("N0") ₴</span></td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    @if (isAdmin)
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action" aria-label="Редагувати"><i class="bi bi-pencil-square"></i></a>
                                    }
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn-action" aria-label="Деталі"><i class="bi bi-info-circle"></i></a>
                                    @if (isAdmin)
                                    {
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn-action text-danger" aria-label="Видалити"><i class="bi bi-trash3"></i></a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
