@model DabaTaseApp.Models.ViewModels.TopUpViewModel

@{
    ViewData["Title"] = "Поповнення";
}

<div class="surface-toolbar">
    <div>
        <p class="eyebrow mb-2">Фінанси</p>
        <h1 class="mb-0">Поповнити баланс</h1>
    </div>
</div>

<div class="card-custom">
    <form asp-action="TopUp" class="row g-3">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="col-12 col-md-6 col-xl-4">
            <label asp-for="Amount" class="form-label">Сума поповнення</label>
            <div class="input-group">
                <input asp-for="Amount" type="text" inputmode="decimal"
                       class="form-control form-control-lg"
                       placeholder="Наприклад: 100,50"
                       autocomplete="off" />
                <span class="input-group-text">₴</span>
            </div>
            <span asp-validation-for="Amount" class="text-danger"></span>
        </div>
        <div class="col-12 d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-wallet2 me-2"></i>Поповнити
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">Назад</a>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
