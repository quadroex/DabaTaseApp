@model DabaTaseApp.Models.PracticeSession

@{
    ViewData["Title"] = "Редагувати практичне заняття";
}

<div class="surface-toolbar">
    <div>
        <p class="eyebrow mb-2">Практика</p>
        <h1 class="mb-0">Редагувати практичне заняття</h1>
    </div>
</div>

<div class="card-custom">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="row g-3">
        <div asp-validation-summary="ModelOnly" class="text-danger col-12"></div>

        <div class="col-12 col-lg-6">
            <label class="form-label text-muted">Учень</label>
            <div class="form-control-plaintext fw-bold">@(Model.Student?.FullName ?? "—")</div>
        </div>

        <div class="col-12 col-lg-6">
            <label class="form-label text-muted">Інструктор</label>
            <div class="form-control-plaintext fw-bold">@(Model.Instructor?.FullName ?? "—")</div>
        </div>

        <div class="col-12 col-lg-6">
            <label class="form-label text-muted">Статус</label>
            <div class="form-control-plaintext">
                <span class="status-badge status-@(Model.Status switch { "Заплановано" => "planned", "Триває" => "ongoing", "Завершено" => "done", _ => "cancelled" })">@Model.Status</span>
            </div>
        </div>

        <div class="col-12"></div>

        <div class="col-12 col-lg-6">
            <label asp-for="StartTime" class="form-label">Час початку</label>
            <input asp-for="StartTime" class="form-control" type="datetime-local" />
            <span asp-validation-for="StartTime" class="text-danger"></span>
        </div>

        <div class="col-12 col-lg-6">
            <label asp-for="EndTime" class="form-label">Час завершення</label>
            <input asp-for="EndTime" class="form-control" type="datetime-local" />
            <span asp-validation-for="EndTime" class="text-danger"></span>
        </div>

        <div class="col-12 col-lg-6">
            <label asp-for="VehiclePlate" class="form-label">Автомобіль</label>
            <select asp-for="VehiclePlate" class="form-select" asp-items="ViewBag.VehiclePlate">
                <option value="">Оберіть автомобіль</option>
            </select>
            <span asp-validation-for="VehiclePlate" class="text-danger"></span>
        </div>

        <div class="col-12 d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check2 me-2"></i>Зберегти
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">Назад</a>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
