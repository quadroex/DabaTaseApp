@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<ul class="navbar-nav ms-auto gap-2 align-items-center border-start border-light ps-lg-4">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <a class="nav-link text-white small" asp-area="Identity" asp-page="/Account/Manage/Index">
                <i class="bi bi-person-circle me-1"></i> @User.Identity?.Name
            </a>
        </li>
        <li class="nav-item">
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button type="submit" class="btn btn-sm btn-outline-light rounded-pill px-3">Вийти</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item"><a class="nav-link text-white opacity-75 small" asp-area="Identity" asp-page="/Account/Register">Реєстрація</a></li>
        <li class="nav-item"><a class="btn btn-sm btn-light text-primary rounded-pill px-4 fw-bold shadow-sm" asp-area="Identity" asp-page="/Account/Login">Увійти</a></li>
    }
</ul>