@model IEnumerable<DabaTaseApp.Models.Student>

@{
    ViewData["Title"] = "Учні";
    var canManage = User.IsInRole(AppRoles.Admin);
    var isInstructor = User.IsInRole(AppRoles.Instructor) && !User.IsInRole(AppRoles.Admin);
    var isStudent = User.IsInRole(AppRoles.Student) && !User.IsInRole(AppRoles.Admin);
    var currentStudentId = ViewBag.CurrentStudentId as int?;

    var heading = canManage
        ? "Керування учнями"
        : isInstructor ? "Учні моїх груп" : "Учні моєї групи";

    var subtitle = canManage
        ? "Картки, групи, баланс та прив'язка до акаунтів."
        : isInstructor
            ? "Перегляд учнів у групах, де ви призначені інструктором теорії."
            : "Список учнів вашої навчальної групи.";

    var emptyText = canManage
        ? "Дані з'являться після створення або прив'язки картки учня."
        : "У доступних вам групах учнів не знайдено.";
}

<div class="surface-toolbar">
    <div>
        <p class="eyebrow mb-2">Навчання</p>
        <h1 class="mb-0">@heading</h1>
        <p class="text-muted mb-0">@subtitle</p>
    </div>
    @if (canManage)
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-2"></i>Додати учня
        </a>
    }
</div>

<div class="card-custom">
    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-mortarboard"></i>
            <h5>Учнів не знайдено</h5>
            <p>@emptyText</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Учень</th>
                        @if (canManage)
                        {
                            <th>Баланс</th>
                        }
                        <th>Категорія</th>
                        <th>Група</th>
                        @if (canManage)
                        {
                            <th>Акаунт</th>
                        }
                        <th class="text-end">Дії</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var canViewDetails = canManage || isInstructor || currentStudentId == item.Id;
                        <tr>
                            <td class="fw-bold">@item.FullName</td>
                            @if (canManage)
                            {
                                <td>
                                    <span class="fw-bold text-@(item.Balance < 0 ? "danger" : "success")">
                                        @item.Balance.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) ₴
                                    </span>
                                </td>
                            }
                            <td><span class="status-badge status-planned">@item.TargetCategory</span></td>
                            <td>@(item.Group?.GroupName ?? "Без групи")</td>
                            @if (canManage)
                            {
                                <td class="text-muted small">@(item.ApplicationUser?.Email ?? "Не прив'язано")</td>
                            }
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    @if (canViewDetails)
                                    {
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn-action" aria-label="Деталі"><i class="bi bi-info-circle"></i></a>
                                    }
                                    @if (canManage)
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action text-primary" aria-label="Редагувати"><i class="bi bi-pencil-square"></i></a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn-action text-danger" aria-label="Видалити"><i class="bi bi-trash3"></i></a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
