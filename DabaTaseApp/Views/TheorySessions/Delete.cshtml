@model DabaTaseApp.Models.TheorySession

@{
    ViewData["Title"] = "Видалити заняття з теорії";
}

<div class="surface-toolbar">
    <div>
        <p class="eyebrow mb-2">Теорія</p>
        <h1 class="mb-0 text-danger">Підтвердження видалення</h1>
    </div>
</div>

<div class="card-custom">
    <p class="text-danger mb-3">Ви впевнені, що хочете видалити це заняття?</p>
    <dl class="row mb-4">
        <dt class="col-sm-3 text-muted">Початок</dt>
        <dd class="col-sm-9 fw-bold">@Model.StartTime.ToString("dd.MM.yyyy HH:mm")</dd>

        <dt class="col-sm-3 text-muted">Закінчення</dt>
        <dd class="col-sm-9">@Model.EndTime.ToString("dd.MM.yyyy HH:mm")</dd>

        <dt class="col-sm-3 text-muted">Аудиторія</dt>
        <dd class="col-sm-9">@Model.Location</dd>

        <dt class="col-sm-3 text-muted">Статус</dt>
        <dd class="col-sm-9">@Model.Status</dd>

        <dt class="col-sm-3 text-muted">Група</dt>
        <dd class="col-sm-9">@(Model.Group?.GroupName ?? "—")</dd>

        <dt class="col-sm-3 text-muted">Інструктор</dt>
        <dd class="col-sm-9">@(Model.Instructor?.FullName ?? "—")</dd>
    </dl>

    <div class="d-flex gap-2">
        <form asp-action="Delete" method="post" class="d-inline">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash3 me-2"></i>Видалити
            </button>
        </form>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>Назад
        </a>
    </div>
</div>
