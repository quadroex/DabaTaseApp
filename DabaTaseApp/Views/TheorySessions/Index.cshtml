@model IEnumerable<DabaTaseApp.Models.TheorySession>

@{
    ViewData["Title"] = "Теоретичні заняття";
    var canManage = User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Instructor);
    var canDelete = User.IsInRole(AppRoles.Admin);
    var isInstructorOnly = User.IsInRole(AppRoles.Instructor) && !User.IsInRole(AppRoles.Admin);
    var showInstructorName = !User.IsInRole(AppRoles.Instructor) || User.IsInRole(AppRoles.Admin);

    var heading = User.IsInRole(AppRoles.Admin)
        ? "Розклад теоретичних занять"
        : User.IsInRole(AppRoles.Instructor)
            ? "Мої теоретичні заняття"
            : "Теорія моєї групи";
}

<div class="surface-toolbar">
    <div>
        <p class="eyebrow mb-2">Теорія</p>
        <h1 class="mb-0">@heading</h1>
        <p class="text-muted mb-0">Лекційний розклад із актуальними статусами.</p>
    </div>
    @if (canManage)
    {
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-2"></i>Нове заняття</a>
    }
</div>

<div class="card-custom">
    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-journal-text"></i>
            <h5>Теоретичних занять не знайдено</h5>
            <p>Розклад групи з'явиться після планування занять.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Час проведення</th>
                        <th>Група</th>
                        <th>Аудиторія</th>
                        <th>Статус</th>
                        <th class="text-end">Дії</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var statusClass = item.Status switch
                        {
                            "Заплановано" => "status-planned",
                            "Триває" => "status-ongoing",
                            "Завершено" => "status-done",
                            _ => "status-cancelled"
                        };
                        var canCancel = canManage && item.Status != "Скасовано" && item.Status != "Завершено";
                        var isDone = item.Status == "Завершено" || item.Status == "Скасовано";
                        var canEdit = canManage && !(isInstructorOnly && isDone);
                        <tr>
                            <td>
                                <div class="fw-bold">@item.StartTime.ToString("dd.MM.yyyy")</div>
                                <div class="small text-muted">@item.StartTime.ToString("HH:mm") - @item.EndTime.ToString("HH:mm")</div>
                            </td>
                            <td>
                                <div class="fw-bold">@item.Group?.GroupName</div>
                                @if (showInstructorName)
                                {
                                    <div class="small text-muted">@item.Instructor?.FullName</div>
                                }
                            </td>
                            <td><span class="status-badge status-planned">@item.Location</span></td>
                            <td><span class="status-badge @statusClass">@item.Status</span></td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn-action" aria-label="Деталі"><i class="bi bi-info-circle"></i></a>
                                    @if (canEdit)
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action text-primary" aria-label="Редагувати"><i class="bi bi-pencil-square"></i></a>
                                    }
                                    @if (canCancel)
                                    {
                                        <form asp-action="Cancel" asp-route-id="@item.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn-action text-warning" aria-label="Скасувати"><i class="bi bi-x-circle"></i></button>
                                        </form>
                                    }
                                    @if (canDelete)
                                    {
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn-action text-danger" aria-label="Видалити"><i class="bi bi-trash3"></i></a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
