@model DabaTaseApp.Models.ViewModels.UsersIndexViewModel

@{
    ViewData["Title"] = "Доступи";
}

<div class="surface-toolbar">
    <div>
        <p class="eyebrow mb-2">Адміністрування</p>
        <h1 class="mb-0">Користувачі та ролі</h1>
        <p class="text-muted mb-0">Акаунти створює адміністратор і прив'язує їх до карток учнів або інструкторів.</p>
    </div>
</div>

<div class="card-custom">
    <h5 class="mb-3">Створити користувача</h5>
    <form asp-action="Create" method="post" class="row g-3" id="createUserForm">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="col-12 col-lg-3">
            <label asp-for="NewUser.Email" class="form-label">Email</label>
            <input asp-for="NewUser.Email" class="form-control" autocomplete="off" />
            <span asp-validation-for="NewUser.Email" class="text-danger"></span>
        </div>

        <div class="col-12 col-lg-2">
            <label asp-for="NewUser.Role" class="form-label">Роль</label>
            <select asp-for="NewUser.Role" class="form-select" id="newUserRole">
                @foreach (var role in Model.AvailableRoles)
                {
                    <option value="@role">@AppRoleDisplay.Name(role)</option>
                }
            </select>
            <span asp-validation-for="NewUser.Role" class="text-danger"></span>
        </div>

        <div class="col-12 col-lg-3">
            <label asp-for="NewUser.Password" class="form-label">Пароль</label>
            <input asp-for="NewUser.Password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="NewUser.Password" class="text-danger"></span>
        </div>

        <div class="col-12 col-lg-3">
            <label asp-for="NewUser.ConfirmPassword" class="form-label">Підтвердження</label>
            <input asp-for="NewUser.ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="NewUser.ConfirmPassword" class="text-danger"></span>
        </div>

        <div class="col-12 col-lg-3 d-none profile-mode-field">
            <label asp-for="NewUser.ProfileMode" class="form-label">Профіль</label>
            <select asp-for="NewUser.ProfileMode" class="form-select" id="profileMode">
                <option value="@ProfileModes.CreateNew">Створити нову картку</option>
                <option value="@ProfileModes.LinkExisting">Прив'язати існуючу</option>
            </select>
            <span asp-validation-for="NewUser.ProfileMode" class="text-danger"></span>
        </div>

        <div class="col-12 col-lg-4 d-none student-create-field instructor-create-field">
            <label asp-for="NewUser.FullName" class="form-label">ПІБ</label>
            <input asp-for="NewUser.FullName" class="form-control" />
            <span asp-validation-for="NewUser.FullName" class="text-danger"></span>
        </div>

        <div class="col-12 col-lg-3 d-none student-create-field">
            <label asp-for="NewUser.TargetCategory" class="form-label">Категорія</label>
            <select asp-for="NewUser.TargetCategory" asp-items="Model.CategoryOptions" class="form-select"></select>
            <span asp-validation-for="NewUser.TargetCategory" class="text-danger"></span>
        </div>

        <div class="col-12 col-lg-3 d-none student-create-field">
            <label asp-for="NewUser.GroupId" class="form-label">Група</label>
            <select asp-for="NewUser.GroupId" asp-items="Model.GroupOptions" class="form-select">
                <option value="">Без групи</option>
            </select>
            <span asp-validation-for="NewUser.GroupId" class="text-danger"></span>
        </div>

        <div class="col-12 col-lg-4 d-none student-link-field">
            <label asp-for="NewUser.ExistingStudentId" class="form-label">Існуючий учень</label>
            <select asp-for="NewUser.ExistingStudentId" asp-items="Model.UnlinkedStudentOptions" class="form-select">
                <option value="">Оберіть учня</option>
            </select>
            <span asp-validation-for="NewUser.ExistingStudentId" class="text-danger"></span>
        </div>

        <div class="col-12 col-lg-3 d-none instructor-create-field">
            <label asp-for="NewUser.PhoneNumber" class="form-label">Телефон</label>
            <input asp-for="NewUser.PhoneNumber" class="form-control" />
            <span asp-validation-for="NewUser.PhoneNumber" class="text-danger"></span>
        </div>

        <div class="col-12 col-lg-3 d-none instructor-create-field">
            <label asp-for="NewUser.LicenseSerial" class="form-label">Ліцензія</label>
            <input asp-for="NewUser.LicenseSerial" class="form-control text-uppercase" />
            <span asp-validation-for="NewUser.LicenseSerial" class="text-danger"></span>
        </div>

        <div class="col-12 col-lg-4 d-none instructor-link-field">
            <label asp-for="NewUser.ExistingInstructorId" class="form-label">Існуючий інструктор</label>
            <select asp-for="NewUser.ExistingInstructorId" asp-items="Model.UnlinkedInstructorOptions" class="form-select">
                <option value="">Оберіть інструктора</option>
            </select>
            <span asp-validation-for="NewUser.ExistingInstructorId" class="text-danger"></span>
        </div>

        <div class="col-12 col-lg-2 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-person-plus me-1"></i>Створити
            </button>
        </div>
    </form>
</div>

<div class="card-custom">
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Користувач</th>
                    <th>Поточна роль</th>
                    <th>Профіль</th>
                    <th class="text-end">Доступ</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    var isStudent = user.Roles.Contains(AppRoles.Student);
                    var isInstructor = user.Roles.Contains(AppRoles.Instructor);

                    <tr>
                        <td>
                            <div class="fw-bold">@user.Email</div>
                            <div class="small text-muted">@user.Id</div>
                        </td>
                        <td>
                            @if (user.Roles.Count == 0)
                            {
                                <span class="text-muted">без ролі</span>
                            }
                            @foreach (var role in user.Roles)
                            {
                                <span class="role-chip role-chip-@role">@AppRoleDisplay.Name(role)</span>
                            }
                        </td>
                        <td class="small">
                            <div class="text-muted mb-2">@user.ProfileStatus</div>

                            @if (user.HasLinkedProfile && (isStudent || isInstructor))
                            {
                                <form asp-action="UnlinkProfile" method="post">
                                    <input type="hidden" name="userId" value="@user.Id" />
                                    <button type="submit" class="btn btn-outline-secondary btn-sm">Відв'язати</button>
                                </form>
                            }
                            else if (isStudent && Model.UnlinkedStudentOptions.Any())
                            {
                                <form asp-action="LinkStudentProfile" method="post" class="d-flex gap-2">
                                    <input type="hidden" name="userId" value="@user.Id" />
                                    <select name="studentId" class="form-select form-select-sm" asp-items="Model.UnlinkedStudentOptions"></select>
                                    <button type="submit" class="btn btn-primary btn-sm">Прив'язати</button>
                                </form>
                            }
                            else if (isInstructor && Model.UnlinkedInstructorOptions.Any())
                            {
                                <form asp-action="LinkInstructorProfile" method="post" class="d-flex gap-2">
                                    <input type="hidden" name="userId" value="@user.Id" />
                                    <select name="instructorId" class="form-select form-select-sm" asp-items="Model.UnlinkedInstructorOptions"></select>
                                    <button type="submit" class="btn btn-primary btn-sm">Прив'язати</button>
                                </form>
                            }
                        </td>
                        <td>
                            @if (user.CanChangeRole)
                            {
                                <form asp-action="UpdateRole" method="post" class="d-flex justify-content-end gap-2">
                                    <input type="hidden" name="userId" value="@user.Id" />
                                    <select name="role" class="form-select form-select-sm role-select">
                                        @if (string.IsNullOrEmpty(user.SelectedRole))
                                        {
                                            <option value="" selected disabled>без ролі</option>
                                        }
                                        @foreach (var role in Model.AvailableRoles)
                                        {
                                            if (role == user.SelectedRole)
                                            {
                                                <option value="@role" selected>@AppRoleDisplay.Name(role)</option>
                                            }
                                            else
                                            {
                                                <option value="@role">@AppRoleDisplay.Name(role)</option>
                                            }
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-primary btn-sm">
                                        <i class="bi bi-shield-lock me-1"></i>Зберегти
                                    </button>
                                </form>
                            }
                            else
                            {
                                <div class="text-end text-muted small">Адміністратора не можна змінити</div>
                            }
                            @if (!user.HasLinkedProfile && !user.Roles.Contains(AppRoles.Admin))
                            {
                                <div class="text-end mt-2">
                                    <a asp-action="Delete" asp-route-id="@user.Id"
                                       class="btn btn-outline-danger btn-sm"
                                       title="Видалити акаунт"
                                       aria-label="Видалити акаунт">
                                        <i class="bi bi-trash3 me-1"></i>Видалити акаунт
                                    </a>
                                </div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        const roleSelect = document.getElementById('newUserRole');
        const profileModeSelect = document.getElementById('profileMode');

        function setVisible(selector, visible) {
            document.querySelectorAll(selector).forEach(el => el.classList.toggle('d-none', !visible));
        }

        function syncProfileFields() {
            const role = roleSelect.value;
            const isStudent = role === 'student';
            const isInstructor = role === 'instructor';
            const isLink = profileModeSelect.value === 'link';

            setVisible('.profile-mode-field', isStudent || isInstructor);
            setVisible('.student-create-field', isStudent && !isLink);
            setVisible('.student-link-field', isStudent && isLink);
            setVisible('.instructor-create-field', isInstructor && !isLink);
            setVisible('.instructor-link-field', isInstructor && isLink);
        }

        roleSelect.addEventListener('change', function () {
            profileModeSelect.value = 'create';
            syncProfileFields();
        });
        profileModeSelect.addEventListener('change', syncProfileFields);
        syncProfileFields();
    </script>
}
