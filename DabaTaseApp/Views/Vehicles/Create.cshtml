@model DabaTaseApp.Models.Vehicle

@{
    ViewData["Title"] = "Додати автомобіль";
}

<div class="surface-toolbar">
    <div>
        <p class="eyebrow mb-2">Автопарк</p>
        <h1 class="mb-0">Новий автомобіль</h1>
    </div>
</div>

<div class="card-custom">
    <form asp-action="Create" class="row g-3">
        <div asp-validation-summary="ModelOnly" class="col-12 text-danger"></div>

        <div class="col-12 col-lg-4">
            <label asp-for="PlateNumber" class="form-label">Номерний знак</label>
            <input asp-for="PlateNumber" class="form-control" placeholder="Наприклад: AA1234BB" />
            <span asp-validation-for="PlateNumber" class="text-danger"></span>
        </div>

        <div class="col-12 col-lg-4">
            <label asp-for="Mark" class="form-label">Марка</label>
            <input asp-for="Mark" class="form-control" placeholder="Наприклад: Toyota" />
            <span asp-validation-for="Mark" class="text-danger"></span>
        </div>

        <div class="col-12 col-lg-4">
            <label asp-for="Model" class="form-label">Модель</label>
            <input asp-for="Model" class="form-control" placeholder="Наприклад: Corolla" />
            <span asp-validation-for="Model" class="text-danger"></span>
        </div>

        <div class="col-12">
            <div class="form-check">
                <input class="form-check-input" asp-for="IsActive" />
                <label class="form-check-label" asp-for="IsActive">Активний</label>
            </div>
        </div>

        <div class="col-12 d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check2 me-2"></i>Створити
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">Назад</a>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
