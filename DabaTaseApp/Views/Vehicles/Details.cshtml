@model DabaTaseApp.Models.Vehicle

@{
    ViewData["Title"] = "Деталі автомобіля";
    var isAdmin = User.IsInRole(AppRoles.Admin);
}

<div class="surface-toolbar">
    <div>
        <p class="eyebrow mb-2">Автопарк</p>
        <h1 class="mb-0">@Model.PlateNumber</h1>
    </div>
    <div class="d-flex gap-2">
        @if (isAdmin)
        {
            <a asp-action="Edit" asp-route-id="@Model.PlateNumber" class="btn btn-outline-primary">
                <i class="bi bi-pencil me-2"></i>Редагувати
            </a>
        }
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>Назад
        </a>
    </div>
</div>

<div class="card-custom">
    <dl class="row mb-0">
        <dt class="col-sm-3 text-muted">Номерний знак</dt>
        <dd class="col-sm-9 fw-bold text-uppercase">@Model.PlateNumber</dd>

        <dt class="col-sm-3 text-muted">Марка</dt>
        <dd class="col-sm-9">@Model.Mark</dd>

        <dt class="col-sm-3 text-muted">Модель</dt>
        <dd class="col-sm-9">@Model.Model</dd>

        <dt class="col-sm-3 text-muted">Статус</dt>
        <dd class="col-sm-9">
            @if (Model.IsActive)
            {
                <span class="status-badge status-done"><i class="bi bi-check-circle-fill me-1"></i>Активний</span>
            }
            else
            {
                <span class="status-badge status-cancelled"><i class="bi bi-x-circle-fill me-1"></i>В ремонті</span>
            }
        </dd>
    </dl>
</div>
