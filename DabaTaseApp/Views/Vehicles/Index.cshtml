@model IEnumerable<DabaTaseApp.Models.Vehicle>
@{
    ViewData["Title"] = "Автопарк";
    var isAdmin = User.IsInRole(AppRoles.Admin);
}

<div class="surface-toolbar">
    <div>
        <p class="eyebrow mb-2">Автопарк</p>
        <h1 class="mb-0">Навчальні авто</h1>
        <p class="text-muted mb-0">Моніторинг стану та доступності транспортних засобів.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-2"></i>Додати автомобіль
    </a>
</div>

<div class="card-custom">
    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-car-front"></i>
            <h5>Автомобілів не знайдено</h5>
            <p>Після додавання першого авто список з'явиться тут.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Номерний знак</th>
                        <th>Марка та модель</th>
                        <th>Статус</th>
                        <th class="text-end">Дії</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold text-uppercase">@item.PlateNumber</td>
                            <td>@item.Mark @item.Model</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="status-badge status-done">
                                        <i class="bi bi-check-circle-fill me-1"></i>Активний
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-cancelled">
                                        <i class="bi bi-x-circle-fill me-1"></i>В ремонті
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    <a asp-action="Details" asp-route-id="@item.PlateNumber" class="btn-action" aria-label="Деталі"><i class="bi bi-info-circle"></i></a>
                                    <a asp-action="Edit" asp-route-id="@item.PlateNumber" class="btn-action text-primary" aria-label="Редагувати"><i class="bi bi-pencil-square"></i></a>
                                    @if (isAdmin)
                                    {
                                        <a asp-action="Delete" asp-route-id="@item.PlateNumber" class="btn-action text-danger" aria-label="Видалити"><i class="bi bi-trash3"></i></a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
